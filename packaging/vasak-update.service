[Unit]
Description=Comprobar si hay actualizaciones de VasakOS
# Sin red no hay nada que comprobar, y el temporizador es persistente: si la
# corrida se saltea, systemd la repone en cuanto haya red.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/vasak-update --check

# El aviso lleva un botón, y `notify-send` con acciones espera a que alguien
# lo apriete o a que el cartel expire. Por eso el proceso vive un rato: el
# límite es lo que impide que un servidor de notificaciones que no expira
# —o que se cuelga— deje esto corriendo hasta el próximo arranque.
TimeoutStartSec=3min

# Endurecido, pero con un límite que se descubrió corriéndolo: `checkupdates`
# baja la base de paquetes con `pacman -Sy`, y pacman la baja dentro de su
# propio aislamiento (fakeroot y su sandbox de descarga). `PrivateDevices`,
# `ProtectKernelTunables`, `ProtectKernelModules` y `ProtectControlGroups`
# —cada uno por su lado— hacen fallar esa bajada con «Cannot fetch updates»,
# así que con ellos el comprobador daba «no se pudo comprobar» en cada corrida
# y nunca el número de actualizaciones. Van sacados a propósito; lo que queda
# endurece sin tocar la descarga.
NoNewPrivileges=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
