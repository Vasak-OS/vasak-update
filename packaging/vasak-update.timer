[Unit]
Description=Comprobar actualizaciones de VasakOS una vez por día

[Timer]
# A los dos minutos de iniciar sesión, y después una vez por día.
OnStartupSec=2min
OnUnitActiveSec=1d

# Hasta una hora de demora al azar. Sin esto, todos los equipos que arrancan a
# la misma hora piden la base de paquetes al mismo espejo en el mismo segundo.
RandomizedDelaySec=1h

# Si el equipo estuvo apagado cuando tocaba, se hace en cuanto se enciende. Un
# comprobador que sólo funciona en máquinas que no se apagan no sirve para una
# portátil, que es donde más falta hace.
Persistent=true

[Install]
WantedBy=timers.target
